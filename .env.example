# Copy to .env and fill in. Never commit .env.
AWS_REGION=us-east-1
# Collection endpoint WITHOUT https://, e.g. abc123xyz.us-east-1.aoss.amazonaws.com
OPENSEARCH_HOST=
# titan = Amazon Titan Text Embeddings V2 via Bedrock (1024 dims, the article's numbers)
# local = Chroma's built-in all-MiniLM-L6-v2 (384 dims, offline practice only)
EMBEDDING_PROVIDER=titan
