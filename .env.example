# Copy to .env and fill in. Never commit the real .env.

AWS_REGION=us-east-1

# Embedding model. EMBED_DIMENSION must match the model's output:
#   amazon.titan-embed-text-v2:0 -> 1024 (also supports 256, 512)
#   amazon.titan-embed-text-v1   -> 1536
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIMENSION=1024

# OpenSearch Serverless. AOSS_ENDPOINT is printed by infra/create_collection.py.
AOSS_COLLECTION_NAME=chroma-to-opensearch
AOSS_ENDPOINT=
OPENSEARCH_INDEX=docs
SEARCH_PIPELINE=hybrid-normalization

TOP_K=5
